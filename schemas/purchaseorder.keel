model PurchaseOrder {
    fields {
        purchaseOrderLineitems PurchaseOrderLineItem[]
        status PurchaseOrderStatus @default(PurchaseOrderStatus.New)
        createdBy User @relation(purchaseOrdersCreated)
        approvedBy User? @relation(purchaseOrdersApproved)
    }

    actions {
        create createPurchaseOrder() with (
            purchaseOrderLineitems.productVariant.id,
            purchaseOrderLineitems.quantity,
            purchaseOrderLineitems.unitCost,
        ) {
            @set(purchaseOrder.createdBy = ctx.identity.user)
        }
        // update updatePurchaseOrder(id) with (
        //     purchaseOrderLineitems.productVariant.id,
        //     purchaseOrderLineitems.quantity,
        //     purchaseOrderLineitems.unitCost,
        // ) {
        //     @permission(expression: ctx.identity.id == purchaseOrder.createdBy.id)
        // }
        update approvePurchaseOrder(id) {
            @set(purchaseOrder.status = PurchaseOrderStatus.Approved)
            @set(purchaseOrder.approvedBy = ctx.identity.user)
            //Accomodates for PO approval flow. Only Admin roles can approve POs.
        }
        list listPurchaseOrder()
        list listPurchaseOrderByCreator(createdBy.id)
        list listPurchaseOrderByApprover(approvedBy.id)
        get getPurchaseOrder(id)
        delete deletePurchaseOrder(id)
    }

    @permission(
        roles: [Admin],
        actions: [create, update, list, get, delete]
    )

    @permission(
        roles: [Staff],
        actions: [create, list, get, update]
    )
}

model PurchaseOrderLineItem {
    fields {
        purchaseOrder PurchaseOrder
        productVariant ProductVariant
        quantity Number
        unitCost Decimal
    }

    actions {
        create createPurchaseOrderLineItem() with (
            purchaseOrder.id,
            productVariant.id,
            quantity,
            unitCost,
        )
        update updatePurchaseOrderLineItem(id)
        get getPurchaseOrderLineItem(id)
        list listPurchaseOrderLineItemByProductVariant(productVariant.id)
        list listPurchaseOrderLineItem()
        list listPurchaseOrderLineItemByPurchaseOrder(purchaseOrder.id) {
            @embed(productVariant)
        }
        delete deletePurchaseOrderLineItem(id)
    }

    @permission(
        expression: true,
        actions: [create, delete, get, list]
    )
}

enum PurchaseOrderStatus {
    New
    Approved
}
