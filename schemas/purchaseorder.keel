model PurchaseOrder {
    fields {
        purchaseOrderLineitems PurchaseOrderLineItem[]
        status PurchaseOrderStatus @default(PurchaseOrderStatus.New)
        createdBy User @relation(purchaseOrdersCreated)
    }

    actions {
        create createPurchaseOrder() with (
            purchaseOrderLineitems.product.id,
            purchaseOrderLineitems.quantity,
            purchaseOrderLineitems.unitCost,
        ) {
            @set(purchaseOrder.createdBy = ctx.identity.user)
        }

        list listPurchaseOrder()
        list listPurchaseOrderByCreator(createdBy.id)
        get getPurchaseOrder(id)
        delete deletePurchaseOrder(id)
    }

    @permission(
        roles: [Admin],
        actions: [create, update, list, get, delete]
    )

    @permission(
        roles: [Staff],
        actions: [create, list, get, update]
    )
}

model PurchaseOrderLineItem {
    fields {
        purchaseOrder PurchaseOrder
        product Product
        quantity Number
        unitCost Decimal
    }

    actions {
        create createPurchaseOrderLineItem() with (
            purchaseOrder.id,
            product.id,
            quantity,
            unitCost,
        )
        update updatePurchaseOrderLineItem(id)
        get getPurchaseOrderLineItem(id)
        list listPurchaseOrderLineItemByProductVariant(product.id)
        list listPurchaseOrderLineItem()
        list listPurchaseOrderLineItemByPurchaseOrder(purchaseOrder.id) {
            @embed(product)
        }
        delete deletePurchaseOrderLineItem(id)
    }

    @permission(
        expression: true,
        actions: [create, delete, get, list]
    )
}

enum PurchaseOrderStatus {
    New
    Submitted
    Completed
}
